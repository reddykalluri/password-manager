<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened runtime entitlements for a notarised WKWebView app. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Keychain access for the biometric session key (Touch ID gating applied
       via SecAccessControl at storage time in a signed build). -->
  <key>keychain-access-groups</key>
  <array>
    <string>$(AppIdentifierPrefix)au.com.rodoskosmos.vault</string>
  </array>
</dict>
</plist>
