<?xml version="1.0" encoding="utf-8"?>
<!-- Vault content (even the encrypted cache) is never included in cloud backup
     or device transfer: keys are hardware-bound and not portable. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
