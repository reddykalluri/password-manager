# Copy to .env and fill in. Used by docker-compose.yml.

# Guards operator endpoints (invites, activity, backup). Use a long random value.
VAULT_OPERATOR_TOKEN=change-me-to-a-long-random-string

# Access-token signing key. Set a stable value so sessions survive restarts.
# Generate e.g. with: openssl rand -hex 32
VAULT_TOKEN_KEY=change-me-to-a-64-char-hex-string
